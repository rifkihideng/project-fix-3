# Salin file ini menjadi .env lalu isi dengan API key Groq kamu.
# Cara dapat key gratis: https://console.groq.com/keys
GROQ_API_KEY=isi_api_key_kamu_disini

# Opsional: ganti model (default sudah pakai model gratis Groq).
# GROQ_MODEL=openai/gpt-oss-20b

# Opsional: batasi jumlah pesan chatbot per IP (default 10 per menit).
# CHAT_RATE_LIMIT=10
# CHAT_RATE_WINDOW_MS=60000
